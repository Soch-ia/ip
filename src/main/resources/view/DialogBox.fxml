<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" maxWidth="Infinity" spacing="10.0" type="HBox"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="messageLabel" maxWidth="310.0" styleClass="message-bubble" wrapText="true" />
        <Label fx:id="avatarLabel" alignment="CENTER" minHeight="42.0" minWidth="42.0"
               prefHeight="42.0" prefWidth="42.0" styleClass="avatar" />
    </children>
</fx:root>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="520.0" styleClass="app-root" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="rene.gui.MainWindow">
    <children>
        <VBox styleClass="app-shell" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="app-header">
                    <children>
                        <StackPane minHeight="52.0" minWidth="52.0" prefHeight="52.0" prefWidth="52.0"
                                   styleClass="brand-mark">
                            <children>
                                <Label styleClass="brand-letter" text="R" />
                            </children>
                        </StackPane>
                        <VBox spacing="2.0">
                            <children>
                                <Label styleClass="header-title" text="Rene" />
                                <Label styleClass="header-subtitle" text="Your focused task companion" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="7.0" styleClass="status-pill">
                            <children>
                                <Region maxHeight="8.0" maxWidth="8.0" minHeight="8.0" minWidth="8.0"
                                        prefHeight="8.0" prefWidth="8.0" styleClass="status-dot" />
                                <Label styleClass="status-text" text="Ready" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <StackPane styleClass="conversation-panel" VBox.vgrow="ALWAYS">
                    <children>
                        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                                    maxHeight="Infinity" maxWidth="Infinity">
                            <content>
                                <VBox fx:id="dialogContainer" spacing="16.0" styleClass="dialog-container" />
                            </content>
                        </ScrollPane>
                    </children>
                </StackPane>
                <VBox spacing="9.0" styleClass="composer-section">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="command-strip">
                            <children>
                                <Label styleClass="command-label" text="QUICK COMMANDS" />
                                <Label styleClass="command-list" text="todo  •  deadline  •  event  •  list  •  find" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" spacing="8.0" styleClass="composer-card">
                            <children>
                                <TextField fx:id="userInput" onAction="#handleUserInput"
                                           promptText="What would you like Rene to do?" HBox.hgrow="ALWAYS" />
                                <Button fx:id="sendButton" defaultButton="true" mnemonicParsing="false"
                                        onAction="#handleUserInput" text="Send  →" />
                            </children>
                        </HBox>
                        <Label styleClass="composer-hint" text="Press Enter to send   •   Type bye to close" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
